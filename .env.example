POSTGRES_PASSWORD=omnidoc
JWT_SECRET=
VAULT_KEY=
VAULT_DIR=data/vault
PINECONE_API_KEY=
PINECONE_NAMESPACE_MODE=shared
PINECONE_INDEX=omnidoc-nexus
PINECONE_REGION=us-east-1
GROQ_MODEL=
OPENROUTER_MODEL=
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_FALLBACK_ORDER=
LLM_TIMEOUT_SECONDS=30
SENDLIB_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=
SMTP_FROM=
GMAIL_SENDER=
SENDLIB_ENABLED=false
SENDLIB_ALLOW_ATTACHMENTS=false
EMAIL_PROVIDER_ORDER=smtp,gmail,sendlib
EMAIL_DAILY_LIMIT_PER_USER=10
EMAIL_TIMEOUT_SECONDS=20
