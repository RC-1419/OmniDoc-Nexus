# Copy to ~/omnidoc/.env ON THE SERVER ONLY, fill it in, then: chmod 600 ~/omnidoc/.env
# Never commit the filled-in file. Use NEW secrets for production, not your development ones.

DOMAIN=your-name.duckdns.org
IMAGE=ghcr.io/your-github-name/your-repo-name:latest   # all lower case

POSTGRES_PASSWORD=
# Generate a Fernet key on the server:  openssl rand -base64 32 | tr '+/' '-_'
VAULT_KEY=
# Generate:  openssl rand -base64 48 | tr -d '\n=+/'
JWT_SECRET=

ENABLE_DOCS=false
CORS_ORIGINS=

# AI, vector store and email: copy the same names you use in your development .env
DEFAULT_LLM=
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_REGION=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
